# ─────────────────────────────────────────────────────────────
# IRONCLAD — Environment Variables
# Copy this file to .env.local and fill in your Insforge details
# ─────────────────────────────────────────────────────────────

# Your Insforge project URL
# Found in: Insforge Dashboard → Settings → API
VITE_INSFORGE_URL=https://YOUR_PROJECT.insforge.io

# Your Insforge anonymous/public key (safe to expose on client)
# Found in: Insforge Dashboard → Settings → API → anon key
VITE_INSFORGE_ANON_KEY=your_insforge_anon_key_here

# NEVER put your service_role or secret key here.
# Row Level Security (RLS) on Insforge enforces multi-tenancy.
